# Copy these into your hosting dashboard's environment variables (never commit real values).

# Leave unset to use a local SQLite file. For PostgreSQL (Supabase) paste its "Session pooler" connection string:
# DATABASE_URL=postgresql://postgres.PROJECTREF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Password the team uses to review submitted products (header X-Reviewer-Key). Change it!
REVIEWER_KEY=change-me

# 1 = if a barcode isn't in our database, ask Open Food Facts (default). 0 = never call the internet.
OFF_LOOKUP=1
